* text=auto
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.patch text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.ico binary
*.png binary
# rexglue codegen rewrites this file with LF. A CRLF copy from the setup
# snapshot would differ on every update and force a full codegen.
app/afrorecomp_manifest.toml text eol=lf
