+      uint8_t* pk = buf + idx * kBytesPerPacket;
+      const uint32_t ffo = xma::GetPacketFrameOffset(pk);
+      if (ffo <= kMaxFrameSizeinBits) {
+        data->input_buffer_read_offset = idx * kBitsPerPacket + ffo;
+        return;
+      }
