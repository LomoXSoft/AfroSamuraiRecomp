+void XmaContext::AfroResumeInBuffer(XMA_CONTEXT_DATA* data, uint32_t overflow) {
+  for (int guard = 0; guard < 2 && data->IsCurrentInputBufferValid(); ++guard) {
+    const uint32_t count = data->GetCurrentInputBufferPacketCount();
+    if (overflow >= count) {
+      overflow -= count;
+      SwapInputBuffer(data);
+      continue;
+    }
