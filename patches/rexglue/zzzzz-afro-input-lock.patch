@@ -83,6 +84,13 @@ class InputSystem : public system::IInputSystem {
 
   rex::ui::Window* window_ = nullptr;
 
+  // afro: guest threads call into this concurrently (XamInputGetState,
+  // GetCapabilities, GetKeystroke...), and every call rebuilds devices_ and
+  // device_owners_. Unlocked, two threads clear and refill the same vectors of
+  // DeviceInfo (with std::string members) at once: heap corruption, seen with
+  // mnk_mode. Recursive because GetState calls GetStateForUI.
+  std::recursive_mutex mutex_;
