+void MnkInputDriver::RecaptureMouseFromUIThread(const char* why) {
+  if (!attached_window_ || !mouse_captured_) {
+    return;
+  }
+  REXLOG_INFO("afro mnk: mouse capture taken again ({})", why);
+  ReleaseMouseCaptureFromUIThread(attached_window_);
+  // The next poll withdraws this if the game no longer wants the mouse.
+  QueueMouseCaptureUpdate(true);
+}
