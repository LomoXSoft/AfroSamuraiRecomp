diff --git a/src/graphics/afro_perf.cpp b/src/graphics/afro_perf.cpp
new file mode 100644
index 0000000..cadb977
--- /dev/null
+++ b/src/graphics/afro_perf.cpp
@@ -0,0 +1,109 @@
+// afro: per-frame perf log. Counters are always collected (relaxed atomics);
+// lines are only written with --afro_perf_log=true.
+#include "afro_perf.h"
+
+#include <algorithm>
+#include <string>
+
+#include <rex/cvar.h>
+#include <rex/logging.h>
+
+#ifdef _WIN32
+#define WIN32_LEAN_AND_MEAN
+#include <windows.h>
+#endif
+
+REXCVAR_DEFINE_BOOL(afro_perf_log, false, "GPU",
+                    "afro: log GPU-emulation perf counters every second and for every slow frame");
+REXCVAR_DEFINE_DOUBLE(afro_perf_slow_ms, 37.0, "GPU",
+                      "afro: frames longer than this (ms, swap to swap) get their own perf line");
+REXCVAR_DEFINE_INT32(afro_perf_log_max, 100000, "GPU", "afro: max afro_perf_log lines");
+
+namespace rex::graphics::afro_perf {
+std::atomic<uint64_t> g[kCount];
+void (*g_idle_poll)(void*) = nullptr;
+void* g_idle_ctx = nullptr;
+
+namespace {
+uint64_t last_swap_us = 0, frame_no = 0, lines = 0;
+uint64_t prev[kCount] = {}, win[kCount] = {};
+uint64_t win_start_us = 0, win_frames = 0, win_slow = 0;
+double win_max_ms = 0;
+#ifdef _WIN32
+uint64_t FileTimeUs(const FILETIME& f) {
+  return ((uint64_t(f.dwHighDateTime) << 32) | f.dwLowDateTime) / 10;
+}
+uint64_t last_proc_cpu_us = 0, last_cp_cpu_us = 0;
+void CpuTimes(uint64_t& proc_us, uint64_t& cp_us) {
+  FILETIME c, e, k, u;
+  proc_us = cp_us = 0;
+  if (GetProcessTimes(GetCurrentProcess(), &c, &e, &k, &u)) proc_us = FileTimeUs(k) + FileTimeUs(u);
+  if (GetThreadTimes(GetCurrentThread(), &c, &e, &k, &u)) cp_us = FileTimeUs(k) + FileTimeUs(u);
+}
+#endif
+
+std::string Fmt(const uint64_t* d, double frame_ms, double frames) {
+  auto ms = [&](Counter c) { return d[c] / 1000.0 / frames; };
+  auto n = [&](Counter c) { return d[c] / frames; };
+  double busy = frame_ms - ms(kCpIdleUs) - ms(kCpWaitRegUs) - ms(kFenceWaitUs);
+  return fmt::format(
+      "draws {:.0f} (skipped {:.0f}) copies {:.0f} rtchg {:.0f} xfer {:.0f} ({:.0f} t) "
+      "pipes+ {:.1f} shaders+ {:.1f} tex {:.1f} ({:.2f} MB) upload {:.2f} MB inval {:.0f} "
+      "readback {:.1f} (sync stalls {:.1f}) occl {:.1f} (sync {:.1f}, dropped {:.1f}) | cp busy {:.1f} idle {:.1f} waitreg {:.1f} fence {:.1f} ms",
+      n(kDraws), n(kDrawsSkipped), n(kCopies), n(kRtChanges), n(kTransfers), n(kTransferTiles),
+      n(kPipelinesNew), n(kShadersTranslated), n(kTextureLoads), n(kTextureLoadBytes) / 1048576.0,
+      n(kUploadBytes) / 1048576.0, n(kInvalidations), n(kReadbacks), n(kReadbackStalls), n(kOcclusionQueries), n(kOcclusionSync),
+      n(kOcclusionDropped), busy, ms(kCpIdleUs),
+      ms(kCpWaitRegUs), ms(kFenceWaitUs));
+}
+}  // namespace
+
+void OnSwap() {
+  const uint64_t now = NowUs();
+  uint64_t cur[kCount], d[kCount];
+  for (int i = 0; i < kCount; ++i) {
+    cur[i] = g[i].load(std::memory_order_relaxed);
+    d[i] = cur[i] - prev[i];
+    prev[i] = cur[i];
+  }
+  ++frame_no;
+  if (!last_swap_us) { last_swap_us = win_start_us = now; return; }
+  const double frame_ms = (now - last_swap_us) / 1000.0;
+  last_swap_us = now;
+  if (!REXCVAR_GET(afro_perf_log)) { win_start_us = now; win_frames = 0; return; }
+  const bool can_log = lines < uint64_t(std::max(REXCVAR_GET(afro_perf_log_max), 0));
+  for (int i = 0; i < kCount; ++i) win[i] += d[i];
+  ++win_frames;
+  if (frame_ms > win_max_ms) win_max_ms = frame_ms;
+  if (frame_ms > REXCVAR_GET(afro_perf_slow_ms)) {
+    ++win_slow;
+    if (can_log) {
+      REXGPU_INFO("afro perf slow frame {}: {:.1f} ms | {}", frame_no, frame_ms, Fmt(d, frame_ms, 1));
+      ++lines;
+    }
+  }
+  const double win_s = (now - win_start_us) / 1e6;
+  if (win_s >= 1.0) {
+    std::string cpu;
+#ifdef _WIN32
+    uint64_t p, c;
+    CpuTimes(p, c);
+    if (last_proc_cpu_us)
+      cpu = fmt::format(" | cpu process {:.0f}% (of one core) cp-thread {:.0f}%",
+                        (p - last_proc_cpu_us) / (win_s * 1e4), (c - last_cp_cpu_us) / (win_s * 1e4));
+    last_proc_cpu_us = p;
+    last_cp_cpu_us = c;
+#endif
+    if (can_log) {
+      REXGPU_INFO("afro perf 1s: {:.1f} fps, max {:.1f} ms, slow {} | per frame: {}{}",
+                  win_frames / win_s, win_max_ms, win_slow,
+                  Fmt(win, win_s * 1000.0 / win_frames, double(win_frames)), cpu);
+      ++lines;
+    }
+    for (auto& w : win) w = 0;
+    win_frames = win_slow = 0;
+    win_max_ms = 0;
+    win_start_us = now;
+  }
+}
+}  // namespace rex::graphics::afro_perf
diff --git a/src/graphics/afro_perf.h b/src/graphics/afro_perf.h
new file mode 100644
index 0000000..cbd5a45
--- /dev/null
+++ b/src/graphics/afro_perf.h
@@ -0,0 +1,34 @@
+// afro: lightweight per-frame GPU-emulation perf counters (afro_perf_log).
+#pragma once
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+
+namespace rex::graphics::afro_perf {
+enum Counter : int {
+  kDraws, kDrawsSkipped, kCopies, kRtChanges, kTransfers, kTransferTiles,
+  kPipelinesNew, kShadersTranslated, kTextureLoads, kTextureLoadBytes,
+  kUploadBytes, kInvalidations, kCpIdleUs, kCpWaitRegUs, kFenceWaitUs,
+  kReadbacks, kReadbackStalls, kOcclusionQueries, kOcclusionSync, kOcclusionDropped,
+  kCount
+};
+extern std::atomic<uint64_t> g[kCount];
+inline void Add(Counter c, uint64_t v = 1) { g[c].fetch_add(v, std::memory_order_relaxed); }
+inline uint64_t NowUs() {
+  return uint64_t(std::chrono::duration_cast<std::chrono::microseconds>(
+                      std::chrono::steady_clock::now().time_since_epoch())
+                      .count());
+}
+// Adds the elapsed microseconds to a counter when it goes out of scope.
+struct ScopedUs {
+  Counter c; uint64_t t0;
+  explicit ScopedUs(Counter c_) : c(c_), t0(NowUs()) {}
+  ~ScopedUs() { Add(c, NowUs() - t0); }
+};
+// Called once per guest frame (IssueSwap) on the command processor thread.
+void OnSwap();
+// Called by the command processor while it idles (waiting for guest commands).
+extern void (*g_idle_poll)(void* ctx);
+extern void* g_idle_ctx;
+inline void IdlePoll() { if (g_idle_poll) g_idle_poll(g_idle_ctx); }
+}  // namespace rex::graphics::afro_perf
