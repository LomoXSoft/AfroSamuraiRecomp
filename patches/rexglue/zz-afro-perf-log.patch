+namespace {
+struct AfroPendingQuery {
+  uint32_t host_index;
+  uint64_t submission;
+  uint32_t address;
+};
+std::deque<AfroPendingQuery> afro_pending_queries;
+void AfroIdlePollThunk(void* ctx) {
+  static_cast<rex::graphics::d3d12::D3D12CommandProcessor*>(ctx)->AfroPollOcclusionQueries(true);
+}
+}  // namespace
+
+void D3D12CommandProcessor::AfroPollOcclusionQueries(bool flush) {
+  if (afro_pending_queries.empty() || !submission_fence_) {
+    return;
+  }
+  if (flush && submission_open_ && afro_pending_queries.back().submission >= submission_current_) {
+    EndSubmission(false);
+  }
+  const uint64_t done = submission_fence_->GetCompletedValue();
+  while (!afro_pending_queries.empty() && afro_pending_queries.front().submission <= done) {
+    const AfroPendingQuery q = afro_pending_queries.front();
+    afro_pending_queries.pop_front();
+    auto* sample_counts = memory_->TranslatePhysical<xenos::xe_gpu_depth_sample_counts*>(q.address);
+    if (sample_counts && occlusion_query_readback_mapping_) {
+      WriteGuestOcclusionResult(sample_counts,
+                                NormalizeOcclusionSamples(occlusion_query_readback_mapping_[q.host_index]));
+    }
+  }
+}
+
+// A new query reusing the memory of a pending one: the guest has re-armed it,
+// so the old result is abandoned (writing it now could clobber the new markers).
+void D3D12CommandProcessor::AfroDropOrAwaitOcclusionQueries(uint32_t address, bool await_all) {
+  if (afro_pending_queries.empty()) {
+    return;
+  }
+  if (await_all) {
+    ::rex::graphics::afro_perf::Add(::rex::graphics::afro_perf::kOcclusionSync);
+    CheckSubmissionFence(afro_pending_queries.back().submission);
+    AfroPollOcclusionQueries(false);
+    afro_pending_queries.clear();
+    return;
+  }
+  for (auto it = afro_pending_queries.begin(); it != afro_pending_queries.end();) {
+    if (it->address == address) {
+      ::rex::graphics::afro_perf::Add(::rex::graphics::afro_perf::kOcclusionDropped);
+      it = afro_pending_queries.erase(it);
+    } else {
+      ++it;
+    }
+  }
+}
