diff --git a/src/graphics/d3d12/command_processor.cpp b/src/graphics/d3d12/command_processor.cpp
--- a/src/graphics/d3d12/command_processor.cpp
+++ b/src/graphics/d3d12/command_processor.cpp
@@ -2196,6 +2196,22 @@
   kernel::xboxkrnl::VdQueryVideoMode(&video_mode);
   uint32_t display_width = std::max(uint32_t(1), uint32_t(video_mode.display_width));
   uint32_t display_height = std::max(uint32_t(1), uint32_t(video_mode.display_height));
+  // afro: the game's executable may show this frame at another aspect than the
+  // video mode's: its ultrawide picture goes back to 16:9 for full-screen movies
+  // and the loading screen (afrorecomp.exe afro_display_aspect, looked up by name
+  // so any other executable is unaffected).
+  {
+    using AfroDisplayAspectFn = int (*)(uint32_t*, uint32_t*);
+    static const AfroDisplayAspectFn afro_display_aspect = reinterpret_cast<AfroDisplayAspectFn>(
+        reinterpret_cast<void*>(GetProcAddress(GetModuleHandleW(nullptr), "afro_display_aspect")));
+    if (afro_display_aspect) {
+      uint32_t w = display_width, h = display_height;
+      if (afro_display_aspect(&w, &h) && w && h) {
+        display_width = w;
+        display_height = h;
+      }
+    }
+  }
 
   presenter->RefreshGuestOutput(
       guest_output_width, guest_output_height, display_width, display_height,
