   if (is_opening_frame) {
     frame_open_ = true;
+    // Arm before any EndSubmission replays this frame's deferred draws.
+    g_afro_renderdoc.Begin(device);
+    if (g_afro_renderdoc.capturing) {
+      deferred_command_list_.InsertDebugMarker("afro-guest-frame");
+    }
 
     // Reset bindings that depend on the data stored in the pools.
     std::memset(current_float_constant_map_vertex_, 0, sizeof(current_float_constant_map_vertex_));
@@ -3531,6 +3668,8 @@ bool D3D12CommandProcessor::EndSubmission(bool is_swap) {
