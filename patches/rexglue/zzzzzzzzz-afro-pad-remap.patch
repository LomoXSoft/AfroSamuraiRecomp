+// Pad prompts follow the controller remap (the runtime's afro_padmap_* cvars, set
+// from the launcher's Key bindings window): for the button the game asks for, the
+// file of the physical button that drives it. The cvar lists 16 physical names
+// (Xbox positions) for A,B,X,Y,LB,RB,LT,RT,Back,Start,LS,RS,Up,Down,Left,Right.
+std::string PadBoundIcon(int32_t family, int32_t glyph) {
+  static constexpr std::array<const char*, 16> kNames = {
+      "A", "B", "X", "Y", "LB", "RB", "LT", "RT", "Back", "Start", "LS", "RS",
+      "Up", "Down", "Left", "Right"};
+  static constexpr std::array<const char*, 16> kIcons = {
+      "A", "B", "X", "Y", "LB", "RB", "LT", "RT", "BACK", "START", "LS", "RS",
+      "DPAD_UP", "DPAD", "DPAD_LEFT", "DPAD_RIGHT"};
+  const char* cvar = family == kFamilyPlayStation ? "afro_padmap_playstation"
+                     : family == kFamilyNintendo  ? "afro_padmap_nintendo"
+                                                  : "afro_padmap_xbox";
+  // The game's only D-pad prompt is D-pad down.
+  const size_t out = glyph == kDpad ? 13 : size_t(glyph);
+  const std::string v = rex::cvar::GetFlagByName(cvar);
+  size_t pos = 0;
+  for (size_t o = 0; o < 16 && pos <= v.size(); ++o) {
+    size_t end = v.find(',', pos);
+    if (o == out) {
+      std::string tok = v.substr(pos, end == std::string::npos ? std::string::npos : end - pos);
+      while (!tok.empty() && tok.front() == ' ') tok.erase(tok.begin());
+      while (!tok.empty() && tok.back() == ' ') tok.pop_back();
+      for (size_t k = 0; k < 16; ++k) {
+        std::string n = kNames[k];
+        if (n.size() == tok.size() &&
+            std::equal(n.begin(), n.end(), tok.begin(), [](char a, char b) {
+              return std::tolower(static_cast<unsigned char>(a)) ==
+                     std::tolower(static_cast<unsigned char>(b));
+            }))
+          return kIcons[k];
+      }
+      break;
+    }
+    if (end == std::string::npos) break;
+    pos = end + 1;
+  }
+  return kGlyphNames[glyph];
+}
