+// afro: button remap (see the afro_padmap_* cvars).
+constexpr std::array<const char*, 16> kAfroPadNames = {
+    "A", "B", "X", "Y", "LB", "RB", "LT", "RT", "Back", "Start", "LS", "RS",
+    "Up", "Down", "Left", "Right"};
+constexpr std::array<uint16_t, 16> kAfroPadMask = {
+    0x1000, 0x2000, 0x4000, 0x8000, 0x0100, 0x0200, 0, 0, 0x0020, 0x0010, 0x0040, 0x0080,
+    0x0001, 0x0002, 0x0004, 0x0008};
+constexpr uint8_t kAfroTriggerOn = 30;  // XINPUT_GAMEPAD_TRIGGER_THRESHOLD
+
+struct AfroPadMap {
+  bool identity = true;
+  std::array<uint8_t, 16> src{};
+};
+
+AfroPadMap ParseAfroPadMap(const std::string& s, const char* which) {
+  AfroPadMap m;
+  for (uint8_t i = 0; i < 16; ++i) m.src[i] = i;
+  if (s.empty()) return m;
+  size_t pos = 0;
+  for (size_t o = 0; o < 16; ++o) {
+    size_t end = s.find(',', pos);
+    std::string tok = s.substr(pos, end == std::string::npos ? std::string::npos : end - pos);
+    while (!tok.empty() && tok.front() == ' ') tok.erase(tok.begin());
+    while (!tok.empty() && tok.back() == ' ') tok.pop_back();
+    int found = -1;
+    for (int k = 0; k < 16; ++k) {
+      if (tok.size() == std::strlen(kAfroPadNames[k]) &&
+          std::equal(tok.begin(), tok.end(), kAfroPadNames[k], [](char a, char b) {
+            return std::tolower(static_cast<unsigned char>(a)) ==
+                   std::tolower(static_cast<unsigned char>(b));
+          })) {
+        found = k;
+      }
+    }
+    if (found < 0 || (end == std::string::npos && o != 15)) {
+      REXLOG_WARN("afro: afro_padmap_{} \"{}\" is not 16 button names; pad left as it is",
+                  which, s);
+      for (uint8_t i = 0; i < 16; ++i) m.src[i] = i;
+      return m;
+    }
+    m.src[o] = static_cast<uint8_t>(found);
+    pos = end + 1;
+  }
+  m.identity = true;
+  for (uint8_t i = 0; i < 16; ++i) m.identity = m.identity && m.src[i] == i;
+  if (!m.identity) REXLOG_INFO("afro: {} pad buttons remapped: {}", which, s);
+  return m;
+}
+
+// Xbox, generic and Steam pads share one map.
+const AfroPadMap& AfroMapForFamily(int32_t family) {
+  static std::string last[3] = {"\x01", "\x01", "\x01"};
+  static AfroPadMap maps[3];
+  const int k = family == 2 ? 1 : family == 3 ? 2 : 0;
+  static const char* const kWhich[3] = {"xbox", "playstation", "nintendo"};
+  const std::string& v = k == 0   ? REXCVAR_GET(afro_padmap_xbox)
+                         : k == 1 ? REXCVAR_GET(afro_padmap_playstation)
+                                  : REXCVAR_GET(afro_padmap_nintendo);
+  if (v != last[k]) {
+    last[k] = v;
+    maps[k] = ParseAfroPadMap(v, kWhich[k]);
+  }
+  return maps[k];
+}
+
+void AfroRemap(X_INPUT_GAMEPAD& gp, const AfroPadMap& m) {
+  if (m.identity) return;
+  const uint16_t in = gp.buttons;
+  const uint8_t lt = gp.left_trigger, rt = gp.right_trigger;
+  auto level = [&](uint8_t s) -> uint8_t {
+    if (s == 6) return lt;
+    if (s == 7) return rt;
+    return (in & kAfroPadMask[s]) ? 255 : 0;
+  };
+  uint16_t all = 0;
+  for (uint16_t mask : kAfroPadMask) all |= mask;
+  uint16_t out = static_cast<uint16_t>(in & ~all);  // guide and the rest stay
+  for (size_t o = 0; o < 16; ++o) {
+    const uint8_t s = m.src[o];
+    const uint8_t v = level(s);
+    if (o == 6) {
+      gp.left_trigger = v;
+    } else if (o == 7) {
+      gp.right_trigger = v;
+    } else if ((s == 6 || s == 7) ? v > kAfroTriggerOn : v != 0) {
+      out |= kAfroPadMask[o];
+    }
+  }
+  gp.buttons = out;
+}
