+void Presenter::ReloadGuestOutputPaintConfigFromUIThread() {
+  SetGuestOutputPaintConfigFromUIThread(BuildGuestOutputPaintConfigFromCVar());
+  LogAfroPaintConfig("change");
+}
+
+void Presenter::AfroOnPaintCvarChanged() {
+  std::unique_lock<std::mutex> lock(afro_presenter_mutex);
+  Presenter* presenter = afro_presenter;
+  if (!presenter) {
+    return;  // None yet: it reads the cvars when it starts.
+  }
+  // The in-game options and the overlays change cvars on the UI thread. From any
+  // other thread, go there first (presenters are destroyed on the UI thread too).
+  WindowedAppContext* context =
+      presenter->window_ ? &presenter->window_->app_context() : nullptr;
+  if (context && !context->IsInUIThread()) {
+    lock.unlock();
+    context->CallInUIThread([] { AfroOnPaintCvarChanged(); });
+    return;
+  }
+  presenter->ReloadGuestOutputPaintConfigFromUIThread();
+}
