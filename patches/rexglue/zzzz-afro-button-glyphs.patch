+// afro: mouse look. Upstream sends the pixels moved since the last poll, so
+// the stick value depends on how often the game polls (uneven speed) and small
+// moves stay inside the game's dead zone (slow start). Instead the stick
+// follows the mouse speed over a short time window, and any movement starts
+// just past the dead zone. Guarded by MnkInputDriver::state_mutex_.
+struct AfroMouseSample {
+  std::chrono::steady_clock::time_point t;
+  float dx, dy;
+};
+std::deque<AfroMouseSample> afro_mouse_samples;
+constexpr size_t kAfroMaxMouseSamples = 4096;
+
+void AfroMouseStick(int32_t& rx, int32_t& ry) {
+  const auto now = std::chrono::steady_clock::now();
+  const auto window = std::chrono::milliseconds(REXCVAR_GET(afro_mouse_window_ms));
+  while (!afro_mouse_samples.empty() && now - afro_mouse_samples.front().t > window) {
+    afro_mouse_samples.pop_front();
+  }
+  double sx = 0.0, sy = 0.0;
+  for (const AfroMouseSample& s : afro_mouse_samples) {
+    sx += s.dx;
+    sy += s.dy;
+  }
+  const double secs = std::chrono::duration<double>(window).count();
+  // Pixels per second to stick fraction. Same speed as upstream at 60 polls a
+  // second: 200 stick units per pixel per poll.
+  constexpr double kScale = 200.0 / 60.0 / 32767.0;
+  const double k = REXCVAR_GET(mnk_sensitivity) * kScale / secs;
+  double fx = sx * k, fy = -sy * k;
+  const double mag = std::hypot(fx, fy);
+  if (mag > 1e-6) {
+    const double dz = REXCVAR_GET(afro_mouse_deadzone);
+    const double out = std::min(1.0, dz + mag * (1.0 - dz));
+    fx *= out / mag;
+    fy *= out / mag;
+  }
+  rx += static_cast<int32_t>(fx * 32767.0);
+  ry += static_cast<int32_t>(fy * 32767.0);
+}
+
+void AfroAddMouseSample(float dx, float dy) {
+  if (dx == 0.0f && dy == 0.0f) return;
+  afro_mouse_samples.push_back({std::chrono::steady_clock::now(), dx, dy});
+  if (afro_mouse_samples.size() > kAfroMaxMouseSamples) afro_mouse_samples.pop_front();
+}
