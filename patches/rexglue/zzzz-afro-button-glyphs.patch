+#pragma once
+// afro: controller-specific button prompts (AfroSamuraiRecomp).
+//
+// The game draws each button prompt as its own 64x64 (A/B/X/Y) or 64x128
+// (triggers) DXT5 texture. When one of those textures is loaded, the texture
+// cache asks this module whether it is a known prompt, by an FNV-1a 64 hash of
+// its untiled, endian-swapped base level (equal to the host BC3 data), and, if
+// the active controller family is not Xbox, for replacement BC3 levels made
+// from glyphs\<family>\<NAME>.png next to the executable. Xbox keeps the
+// original game art.
+
+#include <cstdint>
+#include <vector>
+
+namespace rex::graphics::afro_glyphs {
+
+enum Family : int32_t {
+  kFamilyXbox = 1,
+  kFamilyPlayStation = 2,
+  kFamilyNintendo = 3,
+  kFamilySteam = 4,
+  kFamilyKeyboard = 5,  // keyboard-as-controller (mnk_mode)
+};
+
+// What Identify needs from a texture key and its guest layout.
+struct GuestTexture {
+  uint32_t width;
+  uint32_t height;
+  bool is_dxt5;          // xenos::TextureFormat::k_DXT4_5
+  bool is_2d;            // single 2D slice
+  bool tiled;
+  bool scaled_resolve;
+  uint32_t endianness;   // xenos::Endian
+  uint32_t row_pitch_bytes;  // base level, from the guest layout
+  const uint8_t* base;   // guest memory of the base level
+};
+
+// One mip level of a replacement image, tightly packed BC3 blocks.
+struct Level {
+  uint32_t width;
+  uint32_t height;
+  uint32_t row_bytes;  // blocks per row * 16
+  uint32_t rows;       // block rows
+  std::vector<uint8_t> data;
+};
+
+// Family chosen by --afro_button_glyphs ("auto" follows the last used pad).
+int32_t ResolvedFamily();
+
+// Prompt index of a texture, or -1. Logs and dumps candidates when
+// --afro_glyph_log is on.
+int32_t Identify(const GuestTexture& texture);
+
+// Replacement levels for this prompt and family (level_count levels), or
+// nullptr to keep the game texture.
+const std::vector<Level>* GetReplacement(int32_t family, int32_t glyph, uint32_t width,
+                                         uint32_t height, uint32_t level_count);
+
+// True once after the resolved family changes (checked once per call).
+bool FamilyChanged();
+
+}  // namespace rex::graphics::afro_glyphs
