+void TextureCache::Texture::AfroForceOutdated(
+    [[maybe_unused]] const std::unique_lock<std::recursive_mutex>& global_lock) {
+  SharedMemory& shared_memory = texture_cache().shared_memory();
+  if (GetGuestBaseSize()) {
+    if (base_watch_handle_) {
+      shared_memory.UnwatchMemoryRange(base_watch_handle_);
+      base_watch_handle_ = nullptr;
+    }
+    base_outdated_ = true;
+    outdated_mask_.fetch_or(kOutdatedBitBase, std::memory_order_release);
+  }
+  if (GetGuestMipsSize()) {
+    if (mips_watch_handle_) {
+      shared_memory.UnwatchMemoryRange(mips_watch_handle_);
+      mips_watch_handle_ = nullptr;
+    }
+    mips_outdated_ = true;
+    outdated_mask_.fetch_or(kOutdatedBitMips, std::memory_order_release);
+  }
+}
+
+void TextureCache::AfroRegisterGlyphTexture(const TextureKey& key) {
+  if (std::find(afro_glyph_keys_.begin(), afro_glyph_keys_.end(), key) ==
+      afro_glyph_keys_.end()) {
+    afro_glyph_keys_.push_back(key);
+  }
+}
