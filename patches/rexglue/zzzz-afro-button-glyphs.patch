+REXCVAR_DEFINE_STRING(afro_button_glyphs, "auto", "GPU",
+                      "afro: button prompt icons: auto (follow the last used controller or "
+                      "the keyboard), xbox, playstation, nintendo, steam or keyboard. Xbox "
+                      "keeps the game's own icons.");
+REXCVAR_DEFINE_BOOL(afro_glyph_log, false, "GPU",
+                    "afro: log every small DXT5 texture the game loads, with its prompt hash, "
+                    "and save it as glyph_dump\\<size>_<hash>.dds next to the executable.");
+// Written by the SDL input driver in rexruntime: 0 none yet, else Family.
+REXCVAR_DECLARE(int32_t, afro_pad_family);
+
+namespace rex::graphics::afro_glyphs {
+namespace {
+
+// Prompt names double as the replacement file names. Files are named by the
+// Xbox button POSITION the game asks for: on Nintendo, A.png shows the B label
+// that sits where Xbox A is.
+constexpr std::array<const char*, 13> kGlyphNames = {
+    "A", "B", "X", "Y", "LB", "RB", "LT", "RT", "BACK", "START", "LS", "RS", "DPAD"};
+enum : int32_t { kA, kB, kX, kY, kLB, kRB, kLT, kRT, kBack, kStart, kLS, kRS, kDpad };
+
+struct KnownPrompt {
+  uint64_t hash;  // FNV-1a 64 of the untiled base level
+  int32_t glyph;
+};
+// From RenderDoc captures and afro_glyph_log dumps of the Europe disc (main
+// menu, the first tutorial, the techniques list). The D-pad prompt is the pad
+// with the down arrow lit.
+constexpr KnownPrompt kKnown[] = {
+    {0x758d16bcf27aebd7ull, kA},  {0xe907e7b2220ca146ull, kB},  {0x7a2f3d5b7ea05debull, kX},
+    {0x9bcf40e783552cfdull, kY},  {0xe0136a39bd5482c0ull, kRT}, {0xc1b8d0621ef82983ull, kLT},
+    {0x147970dc9eeee00eull, kLB}, {0x9cd007b6c830df6bull, kDpad},
+};
+
+uint64_t Fnv1a64(const uint8_t* p, size_t n) {
+  uint64_t h = 0xcbf29ce484222325ull;
+  for (size_t i = 0; i < n; ++i) {
+    h ^= p[i];
+    h *= 0x100000001b3ull;
+  }
+  return h;
+}
+
+std::filesystem::path ExeDir() {
+#ifdef _WIN32
+  wchar_t buf[MAX_PATH * 4];
+  DWORD n = GetModuleFileNameW(nullptr, buf, DWORD(std::size(buf)));
+  if (n && n < std::size(buf)) return std::filesystem::path(buf).parent_path();
+#endif
+  return std::filesystem::current_path();
+}
+
+const char* FamilyDir(int32_t family) {
+  switch (family) {
+    case kFamilyPlayStation: return "playstation";
+    case kFamilyNintendo: return "nintendo";
+    case kFamilySteam: return "steam";
+    case kFamilyKeyboard: return "keyboard";
+    default: return "xbox";
+  }
+}
+
+void SwapBlock(uint8_t* b, uint32_t endianness) {
+  switch (endianness) {
+    case 1:  // k8in16
+      for (int i = 0; i < 16; i += 2) std::swap(b[i], b[i + 1]);
+      break;
+    case 2:  // k8in32
+      for (int i = 0; i < 16; i += 4) {
+        std::swap(b[i], b[i + 3]);
+        std::swap(b[i + 1], b[i + 2]);
+      }
+      break;
+    case 3:  // k16in32
+      for (int i = 0; i < 16; i += 4) {
+        std::swap(b[i], b[i + 2]);
+        std::swap(b[i + 1], b[i + 3]);
+      }
+      break;
+    default:
+      break;
+  }
+}
+
+void WriteDds(const std::filesystem::path& path, uint32_t w, uint32_t h,
+              const std::vector<uint8_t>& bc3) {
+  uint32_t hdr[32] = {};
+  hdr[0] = 0x20534444;  // "DDS "
+  hdr[1] = 124;
+  hdr[2] = 0x1 | 0x2 | 0x4 | 0x1000 | 0x80000;
+  hdr[3] = h;
+  hdr[4] = w;
+  hdr[5] = uint32_t(bc3.size());
+  hdr[19] = 32;
+  hdr[20] = 0x4;         // DDPF_FOURCC
+  hdr[21] = 0x35545844;  // "DXT5"
+  hdr[27] = 0x1000;      // DDSCAPS_TEXTURE
+  std::ofstream f(path, std::ios::binary);
+  f.write(reinterpret_cast<const char*>(hdr), sizeof(hdr));
+  f.write(reinterpret_cast<const char*>(bc3.data()), std::streamsize(bc3.size()));
+}
+
+// ---- BC3 encoder (bounding box, good enough for flat icons) --------------
+
+uint16_t To565(const float* c) {
+  auto q = [](float v, int bits) {
+    int m = (1 << bits) - 1;
+    return std::clamp(int(std::lround(v / 255.0f * m)), 0, m);
+  };
+  return uint16_t((q(c[0], 5) << 11) | (q(c[1], 6) << 5) | q(c[2], 5));
+}
+void From565(uint16_t v, float* c) {
+  c[0] = float((v >> 11) & 31) * 255.0f / 31.0f;
+  c[1] = float((v >> 5) & 63) * 255.0f / 63.0f;
+  c[2] = float(v & 31) * 255.0f / 31.0f;
+}
+
+void EncodeBlock(const uint8_t px[16][4], uint8_t* out) {
+  // Alpha: 8-value mode with a0 > a1.
+  uint8_t a_max = 0, a_min = 255;
+  for (int i = 0; i < 16; ++i) {
+    a_max = std::max(a_max, px[i][3]);
+    a_min = std::min(a_min, px[i][3]);
+  }
+  out[0] = a_max;
+  out[1] = a_min;
+  uint64_t a_bits = 0;
+  if (a_max != a_min) {
+    int pal[8] = {a_max, a_min};
+    for (int k = 1; k <= 6; ++k) pal[k + 1] = ((7 - k) * a_max + k * a_min) / 7;
+    for (int i = 0; i < 16; ++i) {
+      int best = 0, best_d = 1 << 30;
+      for (int k = 0; k < 8; ++k) {
+        int d = std::abs(pal[k] - px[i][3]);
+        if (d < best_d) best_d = d, best = k;
+      }
+      a_bits |= uint64_t(best) << (3 * i);
+    }
+  }
+  for (int i = 0; i < 6; ++i) out[2 + i] = uint8_t(a_bits >> (8 * i));
+
+  // Colour: bounding box of the visible texels, inset by 1/16.
+  float lo[3] = {255, 255, 255}, hi[3] = {0, 0, 0};
+  bool any = false;
+  for (int i = 0; i < 16; ++i) {
+    if (px[i][3] == 0) continue;
+    any = true;
+    for (int c = 0; c < 3; ++c) {
+      lo[c] = std::min(lo[c], float(px[i][c]));
+      hi[c] = std::max(hi[c], float(px[i][c]));
+    }
+  }
+  if (!any) {
+    std::memset(lo, 0, sizeof(lo));
+    std::memset(hi, 0, sizeof(hi));
+  }
+  for (int c = 0; c < 3; ++c) {
+    float inset = (hi[c] - lo[c]) / 16.0f;
+    lo[c] += inset;
+    hi[c] -= inset;
+  }
+  uint16_t c0 = To565(hi), c1 = To565(lo);
+  if (c0 < c1) std::swap(c0, c1);
+  uint32_t c_bits = 0;
+  if (c0 != c1) {
+    float pal[4][3];
+    From565(c0, pal[0]);
+    From565(c1, pal[1]);
+    for (int c = 0; c < 3; ++c) {
+      pal[2][c] = (2 * pal[0][c] + pal[1][c]) / 3;
+      pal[3][c] = (pal[0][c] + 2 * pal[1][c]) / 3;
+    }
+    for (int i = 0; i < 16; ++i) {
+      int best = 0;
+      float best_d = 1e30f;
+      for (int k = 0; k < 4; ++k) {
+        float d = 0;
+        for (int c = 0; c < 3; ++c) {
+          float e = pal[k][c] - float(px[i][c]);
+          d += e * e;
+        }
+        if (d < best_d) best_d = d, best = k;
+      }
+      c_bits |= uint32_t(best) << (2 * i);
+    }
+  }
+  out[8] = uint8_t(c0);
+  out[9] = uint8_t(c0 >> 8);
+  out[10] = uint8_t(c1);
+  out[11] = uint8_t(c1 >> 8);
+  for (int i = 0; i < 4; ++i) out[12 + i] = uint8_t(c_bits >> (8 * i));
+}
+
+// Straight RGBA8 image -> BC3 level.
+Level CompressLevel(const std::vector<float>& premul, uint32_t w, uint32_t h) {
+  Level lv;
+  lv.width = w;
+  lv.height = h;
+  uint32_t bx = (w + 3) / 4, by = (h + 3) / 4;
+  lv.row_bytes = bx * 16;
+  lv.rows = by;
+  lv.data.resize(size_t(bx) * by * 16);
+  for (uint32_t y0 = 0; y0 < by; ++y0) {
+    for (uint32_t x0 = 0; x0 < bx; ++x0) {
+      uint8_t px[16][4];
+      for (int i = 0; i < 16; ++i) {
+        uint32_t x = std::min(x0 * 4 + (i & 3), w - 1);
+        uint32_t y = std::min(y0 * 4 + (i >> 2), h - 1);
+        const float* p = &premul[(size_t(y) * w + x) * 4];
+        float a = p[3];
+        for (int c = 0; c < 3; ++c) {
+          float v = a > 0.0f ? p[c] / a : 0.0f;
+          px[i][c] = uint8_t(std::clamp(std::lround(v * 255.0f), 0l, 255l));
+        }
+        px[i][3] = uint8_t(std::clamp(std::lround(a * 255.0f), 0l, 255l));
+      }
+      EncodeBlock(px, &lv.data[(size_t(y0) * bx + x0) * 16]);
+    }
+  }
+  return lv;
+}
+
+bool LoadPng(const std::filesystem::path& path, std::vector<uint8_t>& rgba, int& w, int& h) {
+  std::ifstream f(path, std::ios::binary);
+  if (!f) return false;
+  std::vector<uint8_t> file((std::istreambuf_iterator<char>(f)), std::istreambuf_iterator<char>());
+  int n = 0;
+  stbi_uc* p = stbi_load_from_memory(file.data(), int(file.size()), &w, &h, &n, 4);
+  if (!p) return false;
+  rgba.assign(p, p + size_t(w) * h * 4);
+  stbi_image_free(p);
+  return true;
+}
+
+// Fits the PNG inside w x h (aspect kept, centred, transparent around it) and
+// builds level_count BC3 levels with a premultiplied box filter.
+std::vector<Level> BuildLevels(const std::vector<uint8_t>& src, int sw, int sh, uint32_t w,
+                               uint32_t h, uint32_t level_count) {
+  float scale = std::min(float(w) / float(sw), float(h) / float(sh));
+  float dw = sw * scale, dh = sh * scale;
+  float ox = (float(w) - dw) * 0.5f, oy = (float(h) - dh) * 0.5f;
+  // Supersampled bilinear into a premultiplied float image.
+  std::vector<float> img(size_t(w) * h * 4, 0.0f);
+  auto texel = [&](int x, int y, float* o) {
+    x = std::clamp(x, 0, sw - 1);
+    y = std::clamp(y, 0, sh - 1);
+    const uint8_t* p = &src[(size_t(y) * sw + x) * 4];
+    float a = p[3] / 255.0f;
+    o[0] = p[0] / 255.0f * a;
+    o[1] = p[1] / 255.0f * a;
+    o[2] = p[2] / 255.0f * a;
+    o[3] = a;
+  };
+  constexpr int kSS = 4;
+  for (uint32_t y = 0; y < h; ++y) {
+    for (uint32_t x = 0; x < w; ++x) {
+      float acc[4] = {};
+      for (int sy = 0; sy < kSS; ++sy) {
+        for (int sx = 0; sx < kSS; ++sx) {
+          float fx = (float(x) + (sx + 0.5f) / kSS - ox) / scale - 0.5f;
+          float fy = (float(y) + (sy + 0.5f) / kSS - oy) / scale - 0.5f;
+          if (fx < -0.5f || fy < -0.5f || fx > sw - 0.5f || fy > sh - 0.5f) continue;
+          int ix = int(std::floor(fx)), iy = int(std::floor(fy));
+          float tx = fx - ix, ty = fy - iy;
+          float t00[4], t10[4], t01[4], t11[4];
+          texel(ix, iy, t00);
+          texel(ix + 1, iy, t10);
+          texel(ix, iy + 1, t01);
+          texel(ix + 1, iy + 1, t11);
+          for (int c = 0; c < 4; ++c) {
+            acc[c] += (t00[c] * (1 - tx) + t10[c] * tx) * (1 - ty) +
+                      (t01[c] * (1 - tx) + t11[c] * tx) * ty;
+          }
+        }
+      }
+      for (int c = 0; c < 4; ++c) img[(size_t(y) * w + x) * 4 + c] = acc[c] / (kSS * kSS);
+    }
+  }
+  std::vector<Level> levels;
+  uint32_t lw = w, lh = h;
+  for (uint32_t level = 0; level < level_count; ++level) {
+    levels.push_back(CompressLevel(img, lw, lh));
+    if (level + 1 == level_count) break;
+    uint32_t nw = std::max(lw / 2, 1u), nh = std::max(lh / 2, 1u);
+    std::vector<float> next(size_t(nw) * nh * 4, 0.0f);
+    for (uint32_t y = 0; y < nh; ++y) {
+      for (uint32_t x = 0; x < nw; ++x) {
+        for (int c = 0; c < 4; ++c) {
+          float s = 0;
+          int n = 0;
+          for (uint32_t dy = 0; dy < 2; ++dy) {
+            for (uint32_t dx = 0; dx < 2; ++dx) {
+              uint32_t sx = std::min(x * 2 + dx, lw - 1), sy = std::min(y * 2 + dy, lh - 1);
+              s += img[(size_t(sy) * lw + sx) * 4 + c];
+              ++n;
+            }
+          }
+          next[(size_t(y) * nw + x) * 4 + c] = s / n;
+        }
+      }
+    }
+    img.swap(next);
+    lw = nw;
+    lh = nh;
+  }
+  return levels;
+}
+
+}  // namespace
+
+int32_t ResolvedFamily() {
+  const std::string& s = REXCVAR_GET(afro_button_glyphs);
+  if (s == "xbox") return kFamilyXbox;
+  if (s == "playstation" || s == "ps") return kFamilyPlayStation;
+  if (s == "nintendo" || s == "switch") return kFamilyNintendo;
+  if (s == "steam") return kFamilySteam;
+  if (s == "keyboard") return kFamilyKeyboard;
+  int32_t pad = REXCVAR_GET(afro_pad_family);
+  return (pad >= kFamilyXbox && pad <= kFamilyKeyboard) ? pad : kFamilyXbox;
+}
+
+int32_t Identify(const GuestTexture& t) {
+  if (!t.is_dxt5 || !t.is_2d || !t.tiled || t.scaled_resolve || t.base == nullptr) return -1;
+  // 64x64 face buttons and D-pad, 64x128 triggers, 128x64 shoulders.
+  bool prompt_size = (t.width == 64 && (t.height == 64 || t.height == 128)) ||
+                     (t.width == 128 && t.height == 64);
+  bool log = REXCVAR_GET(afro_glyph_log);
+  bool log_size = t.width >= 16 && t.height >= 16 && t.width <= 128 && t.height <= 128 &&
+                  !(t.width & 3) && !(t.height & 3);
+  if (!prompt_size && !(log && log_size)) return -1;
+
+  uint32_t bx = t.width / 4, by = t.height / 4;
+  uint32_t pitch_blocks = t.row_pitch_bytes / 16;
+  std::vector<uint8_t> tight(size_t(bx) * by * 16);
+  for (uint32_t y = 0; y < by; ++y) {
+    for (uint32_t x = 0; x < bx; ++x) {
+      int32_t off = texture_util::GetTiledOffset2D(int32_t(x), int32_t(y), pitch_blocks, 4);
+      uint8_t* dst = &tight[(size_t(y) * bx + x) * 16];
+      std::memcpy(dst, t.base + off, 16);
+      SwapBlock(dst, t.endianness);
+    }
+  }
+  uint64_t hash = Fnv1a64(tight.data(), tight.size());
+  int32_t glyph = -1;
+  for (const KnownPrompt& k : kKnown) {
+    if (k.hash == hash) glyph = k.glyph;
+  }
+
+  static std::set<uint64_t> seen;
+  if (seen.insert(hash).second) {
+    if (glyph >= 0) {
+      REXGPU_INFO("afro glyphs: prompt {} loaded ({}x{}, {:016x})", kGlyphNames[glyph], t.width,
+                  t.height, hash);
+    } else if (log) {
+      REXGPU_WARN("afro glyphs: candidate {}x{} {:016x}", t.width, t.height, hash);
+    }
+    if (log) {
+      std::error_code ec;
+      std::filesystem::path dir = ExeDir() / "glyph_dump";
+      std::filesystem::create_directories(dir, ec);
+      char name[64];
+      std::snprintf(name, sizeof(name), "%ux%u_%016llx.dds", t.width, t.height,
+                    static_cast<unsigned long long>(hash));
+      WriteDds(dir / name, t.width, t.height, tight);
+    }
+  }
+  return glyph;
+}
+
+const std::vector<Level>* GetReplacement(int32_t family, int32_t glyph, uint32_t width,
+                                         uint32_t height, uint32_t level_count) {
+  if (glyph < 0 || glyph >= int32_t(kGlyphNames.size())) return nullptr;
+  using Key = std::tuple<int32_t, int32_t, uint32_t, uint32_t, uint32_t>;
+  static std::map<Key, std::vector<Level>> cache;
+  static std::set<Key> missing;
+  Key key{family, glyph, width, height, level_count};
+  if (auto it = cache.find(key); it != cache.end()) return &it->second;
+  if (missing.count(key)) return nullptr;
+  // Xbox has no folder unless someone adds one: the original icons stay.
+  std::filesystem::path png =
+      ExeDir() / "glyphs" / FamilyDir(family) / (std::string(kGlyphNames[glyph]) + ".png");
+  std::vector<uint8_t> rgba;
+  int sw = 0, sh = 0;
+  if (!LoadPng(png, rgba, sw, sh) || sw <= 0 || sh <= 0) {
+    if (family != kFamilyXbox) {
+      REXGPU_WARN("afro glyphs: no replacement {}; keeping the game icon", png.string());
+    }
+    missing.insert(key);
+    return nullptr;
+  }
+  auto& levels = cache[key] = BuildLevels(rgba, sw, sh, width, height, level_count);
+  REXGPU_INFO("afro glyphs: {} {} from {}", FamilyDir(family), kGlyphNames[glyph], png.string());
+  return &levels;
+}
+
+bool FamilyChanged() {
+  static int32_t last = 0;
+  int32_t now = ResolvedFamily();
+  if (last == 0) {
+    last = now;
+    return false;
+  }
+  if (now == last) return false;
+  REXGPU_INFO("afro glyphs: controller family {} -> {}", FamilyDir(last), FamilyDir(now));
+  last = now;
+  return true;
+}
+
+}  // namespace rex::graphics::afro_glyphs
