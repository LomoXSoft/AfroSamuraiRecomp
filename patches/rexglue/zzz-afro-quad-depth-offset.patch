+// Quad constant depth offset. half is the default. full uses twice that
+// constant; off is the original integer bias. The slope term stays.
+// Read once at GPU init. A command-line or REX_AFRO_QUAD_DEPTH_OFFSET value
+// overrides the default. Not a console-correct fix and not a global change.
+REXCVAR_DEFINE_STRING(
+    afro_quad_depth_offset, "half", "GPU",
+    "afro: half (default), full, or off. Quad lists with a nonzero guest "
+    "constant polygon offset clear the D3D constant depth bias and add that "
+    "absolute offset in the geometry shader. Slope is unchanged. Zero-offset "
+    "draws are unchanged. Not a console-correct or global fix.")
+    .lifecycle(rex::cvar::Lifecycle::kInitOnly);
+
+REXCVAR_DECLARE(bool, force_convert_quad_lists_to_triangle_lists);
+
 REXCVAR_DEFINE_BOOL(d3d12_readback_memexport, false, "GPU/D3D12",
