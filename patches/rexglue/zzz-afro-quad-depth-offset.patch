@@ -4223,6 +4237,46 @@ void D3D12CommandProcessor::UpdateSystemConstantValues(
     system_constants_.edram_blend_constant[3] = regs.Get<float>(XE_GPU_REG_RB_BLEND_ALPHA);
   }
 
+  // Afro experimental quad constant. 0 unless this draw is a non-tessellated
+  // quad list on the host-RTV path with a nonzero constant offset and the
+  // launcher mode is full or half. The geometry shader adds this to clip Z.
+  {
+    float ndc_add = 0.0f;
+    const std::string& quad_mode = REXCVAR_GET(afro_quad_depth_offset);
+    const bool quad_mode_on = quad_mode == "full" || quad_mode == "half";
+    static bool quad_mode_logged = false;
+    if (quad_mode_on && !quad_mode_logged) {
+      quad_mode_logged = true;
+      REXGPU_INFO(
+          "afro quad depth offset: mode {} (experimental, not a console fix; "
+          "quad lists with a nonzero constant only; slope kept; raster constant "
+          "bias cleared; zero-offset draws unchanged)",
+          quad_mode);
+    }
+    const bool tessellation_enabled =
+        xenos::IsMajorModeExplicit(vgt_draw_initiator.major_mode, vgt_draw_initiator.prim_type) &&
+        regs.Get<reg::VGT_OUTPUT_PATH_CNTL>().path_select ==
+            xenos::VGTOutputPath::kTessellationEnable;
+    const bool quad_gs = !edram_rov_used && !tessellation_enabled &&
+                         vgt_draw_initiator.prim_type == xenos::PrimitiveType::kQuadList &&
+                         !REXCVAR_GET(force_convert_quad_lists_to_triangle_lists);
+    if (quad_mode_on && quad_gs) {
+      float polygon_offset_scale = 0.0f, polygon_offset = 0.0f;
+      draw_util::GetPreferredFacePolygonOffset(regs, primitive_polygonal, polygon_offset_scale,
+                                               polygon_offset);
+      const int32_t bias = draw_util::GetD3D10IntegerPolygonOffset(
+          regs.Get<reg::RB_DEPTH_INFO>().depth_format, polygon_offset);
+      const float range = viewport_info.z_max - viewport_info.z_min;
+      // full: the integer's design bin (exponent -1). half: the next bin.
+      const float constant = (quad_mode == "half" ? 0.5f : 1.0f) * (float(bias) / 16777216.0f);
+      if (bias != 0 && range > 1.0e-8f && range < 1.0e8f && constant == constant) {
+        ndc_add = constant / range;
+      }
+    }
+    dirty |= system_constants_.afro_quad_depth_ndc_add != ndc_add;
+    system_constants_.afro_quad_depth_ndc_add = ndc_add;
+  }
+
   cbuffer_binding_system_.up_to_date &= !dirty;
 }
 
