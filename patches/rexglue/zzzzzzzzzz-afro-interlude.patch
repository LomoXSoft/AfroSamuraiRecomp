+// afro: loading interlude helpers (see input_system.h).
+std::atomic<uint32_t> afro_presses{0};
+std::array<uint16_t, kMaxGuestUsers> afro_prev_buttons = {};
+std::mutex afro_dialog_mutex;
+std::vector<uint64_t> afro_dialog_hashes;
+uint64_t afro_last_hash = 0;
+std::chrono::steady_clock::time_point afro_last_open{};
+std::chrono::steady_clock::time_point afro_voice_end{};
+
+// Length in seconds of one of the game's XMA files: RIFF with a big-endian XMA2
+// chunk (sample rate at +12) and a seek chunk whose last entry is the sample
+// count. 0 when it cannot be read.
+double AfroXmaSeconds(const std::string& guest_path) {
+  std::string root = rex::cvar::GetFlagByName("game_data_root");
+  size_t colon = guest_path.find(":\\");
+  if (root.empty() || colon == std::string::npos) return 0;
+  std::ifstream f(std::filesystem::path(root) / guest_path.substr(colon + 2), std::ios::binary);
+  if (!f) return 0;
+  std::vector<uint8_t> d((std::istreambuf_iterator<char>(f)), std::istreambuf_iterator<char>());
+  auto le = [&](size_t o) {
+    return uint32_t(d[o]) | uint32_t(d[o + 1]) << 8 | uint32_t(d[o + 2]) << 16 | uint32_t(d[o + 3]) << 24;
+  };
+  auto be = [&](size_t o) {
+    return uint32_t(d[o]) << 24 | uint32_t(d[o + 1]) << 16 | uint32_t(d[o + 2]) << 8 | uint32_t(d[o + 3]);
+  };
+  if (d.size() < 12 || std::memcmp(d.data(), "RIFF", 4) != 0) return 0;
+  uint32_t rate = 0, samples = 0;
+  for (size_t pos = 12; pos + 8 <= d.size();) {
+    const uint32_t size = le(pos + 4);
+    const size_t body = pos + 8;
+    if (body + size > d.size()) break;
+    if (std::memcmp(&d[pos], "XMA2", 4) == 0 && size >= 16) rate = be(body + 12);
+    if (std::memcmp(&d[pos], "seek", 4) == 0 && size >= 4) samples = be(body + size - 4);
+    pos = body + size + (size & 1);
+  }
+  return rate ? double(samples) / rate : 0;
+}
+
 }  // namespace
 
+uint32_t AfroButtonPresses() {
+  return afro_presses.load(std::memory_order_relaxed);
+}
+
+void AfroNoteDialogOpen(std::string_view path) {
+  std::string p(path);
+  std::transform(p.begin(), p.end(), p.begin(),
+                 [](unsigned char c) { return char(std::tolower(c)); });
+  if (p.find("\\dialog\\") == std::string::npos || p.find("noise") != std::string::npos) return;
+  uint64_t h = 1469598103934665603ull;
+  for (unsigned char c : p) h = (h ^ c) * 1099511628211ull;
+  {
+    std::lock_guard lock(afro_dialog_mutex);
+    const auto now = std::chrono::steady_clock::now();
+    if (h == afro_last_hash && now - afro_last_open < std::chrono::milliseconds(500)) return;
+    afro_last_hash = h;
+    afro_last_open = now;
+    afro_dialog_hashes.push_back(h);
+    afro_voice_end = now;
+  }
+  const double secs = AfroXmaSeconds(std::string(path));
+  std::lock_guard lock(afro_dialog_mutex);
+  const auto end = afro_last_open + std::chrono::duration_cast<std::chrono::steady_clock::duration>(
+                                        std::chrono::duration<double>(secs));
+  if (end > afro_voice_end) afro_voice_end = end;
+}
+
+double AfroVoiceSilenceSeconds() {
+  std::lock_guard lock(afro_dialog_mutex);
+  if (afro_voice_end.time_since_epoch().count() == 0) return 1e9;
+  return std::chrono::duration<double>(std::chrono::steady_clock::now() - afro_voice_end).count();
+}
+
+uint32_t AfroDialogOpenCount() {
+  std::lock_guard lock(afro_dialog_mutex);
+  return uint32_t(afro_dialog_hashes.size());
+}
+
+uint64_t AfroDialogOpenHash(uint32_t index) {
+  std::lock_guard lock(afro_dialog_mutex);
+  return index < afro_dialog_hashes.size() ? afro_dialog_hashes[index] : 0;
+}
